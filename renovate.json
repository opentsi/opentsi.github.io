{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges"
  ],
  "schedule": [
    "before 3am on Monday"
  ],
  "timezone": "Europe/Zurich",
  "rangeStrategy": "bump",
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchPackagePatterns": ["^@astrojs/", "^astro$"],
      "groupName": "Astro packages",
      "schedule": ["before 3am on Monday"]
    },
    {
      "matchPackagePatterns": ["^@tailwindcss/", "^tailwindcss$"],
      "groupName": "Tailwind CSS packages"
    },
    {
      "matchPackagePatterns": ["^vue"],
      "groupName": "Vue packages"
    },
    {
      "matchPackagePatterns": ["^@types/"],
      "groupName": "TypeScript definitions",
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "labels": ["dependencies"],
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true
}
